    {
      "dot": "cyan",
      "title": "Primary Path: Live Wait-Time Estimation",
      "items": [
        "Customer requests wait time via GET /api/queue-entries/{id}/estimate",
        "Spring Security validates JWT token & user permissions",
        "WaitTimeEstimationService extracts queue backlog & active counter metrics",
        "PredictionClient dispatches HTTP call to Python FastAPI POST /predict",
        "Gradient Boosting Regressor calculates sub-minute wait-time adjustment"
      ]
    },
    {
      "dot": "amber",
      "title": "Circuit-Breaker & Resilient Fallback",
      "items": [
        "PredictionClient configured with 2000ms connect and 3000ms read timeouts",
        "Zero-downtime degradation: falls back to deterministic formula ⌈(P × D) / C⌉",
        "System remains fully functional if Python ML service is offline or slow"
      ]
    },
    {
      "dot": "emerald",
      "title": "Queue Concurrency & Persistence",
      "items": [
        "Sequential atomic token allocation: T-001, T-002, T-003",
        "Strict FIFO ordering and concurrency-safe token advancement",
        "Spring Data JPA with H2 in-memory (dev) and MySQL profile (prod)"
      ]
    }
